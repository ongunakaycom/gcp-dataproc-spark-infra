# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude variable files that may contain sensitive values.
# Commit `terraform.tfvars.example` instead of a real `terraform.tfvars`.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Saved plan files and generated plan JSON
*.tfplan
tfplan
plan.json

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE files
.idea/
.vscode/
*.swp
*.swo
*~
